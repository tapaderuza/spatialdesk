<!--
  The agent's card, shown before anything changes and afterwards to explain it. Centimetres at real size (46 x 55),
  placed half a metre in front of the user like a card handed over. Modes (src/agent/agent-system.ts): a plan to
  review, a suggestion the agent makes on its own, and "what the AI did" with an Undo per step (8 x 6 cm). The source
  is always shown (Amazon Nova or the built-in planner). While Nova thinks, an orb breathes beside the summary
  (#plan-thinking). Hover is painted by the app (no :hover styles).
-->
<style>
  .root { flex-direction: column; width: 46; height: 55; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; gap: 0.8; background-color: #15181e; border-radius: 2.4; border-width: 0.4; border-color: #5b8def; }
  .header { flex-direction: row; align-items: center; justify-content: space-between; height: 3.4; }
  .title { font-size: 2.4; font-weight: 700; color: #eef1f5; }
  .source { flex-shrink: 1; margin-left: 1; font-size: 1.4; color: #9cc3ff; }
  .summary-row { flex-direction: row; align-items: center; }
  .summary { flex-grow: 1; flex-shrink: 1; height: 6.4; font-size: 1.7; color: #eef1f5; overflow: hidden; }
  .steps { flex-direction: column; gap: 0.6; height: 28.2; }
  .step { flex-direction: row; align-items: center; gap: 0.8; height: 6.6; padding-left: 1.2; padding-right: 0.3; border-radius: 1; background-color: #1d222a; overflow: hidden; }
  .step-text { flex-direction: column; flex-grow: 1; flex-shrink: 1; }
  .step-title { font-size: 1.5; font-weight: 700; color: #eef1f5; }
  .step-why { font-size: 1.3; color: #b9c2cf; }
  .step-undo { flex-shrink: 0; width: 8; height: 6; align-items: center; justify-content: center; border-radius: 1; background-color: #2a313b; border-width: 0.3; border-color: #2a313b; }
  .step-undo-label { font-size: 1.5; font-weight: 700; color: #eef1f5; }
  .thinking { display: none; flex-shrink: 0; width: 6.4; height: 6.4; margin-right: 1.2; align-items: center; justify-content: center; }
  .halo { width: 5.6; height: 5.6; border-radius: 2.8; align-items: center; justify-content: center; background-color: #8f6bff; }
  .core { width: 2.4; height: 2.4; border-radius: 1.2; background-color: #ece4ff; }
  .note { height: 2.4; font-size: 1.4; color: #f2b84b; }
  .conversation { display: none; flex-direction: column; justify-content: space-between; height: 18.6; gap: 1; padding-top: 1; padding-bottom: 1; }
  .said { font-size: 1.6; color: #b9c2cf; height: 4.6; overflow: hidden; }
  .memory { font-size: 1.5; color: #9cc3ff; height: 4; }
  .forget { height: 6; align-items: center; justify-content: center; border-radius: 1.4; border-width: 0.3; border-color: #2a313b; background-color: #2a313b; }
  .buttons { flex-direction: row; gap: 1.2; height: 7; }
  .btn { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2a313b; border-width: 0.3; border-color: #2a313b; }
  .primary { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2f5f9e; border-width: 0.3; border-color: #2f5f9e; }
  .label { font-size: 1.8; font-weight: 700; color: #eef1f5; }
  .root:dark { background-color: #000000; border-color: #ffffff; }
  .title:dark { color: #ffffff; }
  .source:dark { color: #ffffff; }
  .step:dark { background-color: #000000; }
  .step-why:dark { color: #ffffff; }
  .note:dark { color: #ffd400; }
  .memory:dark { color: #ffffff; }
  .said:dark { color: #ffffff; }
  .label:dark { color: #ffffff; }
  .core:dark { background-color: #ffffff; }
</style>
<div id="plan-root" class="root">
  <div class="header">
    <div id="plan-title" class="title">AI plan</div>
    <div id="plan-source" class="source">Amazon Nova</div>
  </div>
  <div class="summary-row">
    <div id="plan-thinking" class="thinking"><div id="plan-thinking-halo" class="halo"><div id="plan-thinking-core" class="core"></div></div></div>
    <div id="plan-summary" class="summary">Planning...</div>
  </div>
  <div id="plan-steps" class="steps">
    <div id="step-0" class="step"><div class="step-text"><div id="step-0-title" class="step-title">Step</div><div id="step-0-why" class="step-why">Why</div></div><div id="step-0-undo" class="step-undo"><div id="step-0-undo-label" class="step-undo-label">Undo</div></div></div>
    <div id="step-1" class="step"><div class="step-text"><div id="step-1-title" class="step-title">Step</div><div id="step-1-why" class="step-why">Why</div></div><div id="step-1-undo" class="step-undo"><div id="step-1-undo-label" class="step-undo-label">Undo</div></div></div>
    <div id="step-2" class="step"><div class="step-text"><div id="step-2-title" class="step-title">Step</div><div id="step-2-why" class="step-why">Why</div></div><div id="step-2-undo" class="step-undo"><div id="step-2-undo-label" class="step-undo-label">Undo</div></div></div>
    <div id="step-3" class="step"><div class="step-text"><div id="step-3-title" class="step-title">Step</div><div id="step-3-why" class="step-why">Why</div></div><div id="step-3-undo" class="step-undo"><div id="step-3-undo-label" class="step-undo-label">Undo</div></div></div>
  </div>
  <div id="plan-conversation" class="conversation">
    <div id="plan-said" class="said"></div>
    <div id="plan-memory" class="memory">This visit only. You control what changes.</div>
    <div id="plan-forget" class="forget"><div id="plan-forget-label" class="label">Forget conversation</div></div>
    <div id="plan-profile-controls" class="buttons" style="display: none; height: 6">
      <div id="plan-restore-setup" class="primary"><div id="plan-restore-label" class="label">Restore</div></div>
      <div id="plan-forget-setup" class="btn"><div id="plan-forget-setup-label" class="label">Forget saved</div></div>
    </div>
    <div id="plan-session-controls" style="display: none; flex-direction: column; gap: 1.5">
      <div class="buttons" style="height: 6">
        <div id="session-5" class="btn"><div id="session-5-label" class="label">5 min</div></div>
        <div id="session-15" class="btn"><div id="session-15-label" class="label">15 min</div></div>
        <div id="session-25" class="btn"><div id="session-25-label" class="label">25 min</div></div>
      </div>
      <div class="buttons" style="height: 6">
        <div id="energy-low" class="btn"><div id="energy-low-label" class="label">Low energy</div></div>
        <div id="energy-steady" class="btn"><div id="energy-steady-label" class="label">Steady</div></div>
      </div>
      <div id="session-return" class="forget"><div id="session-return-label" class="label">Pause / resume</div></div>
    </div>
    <div id="plan-return-controls" style="display: none; flex-direction: column; gap: 1">
      <div id="return-edit-controls" class="buttons" style="height: 6">
        <div id="return-task" class="btn"><div id="return-task-label" class="label">Other task</div></div>
        <div id="return-note" class="btn"><div id="return-note-label" class="label">Dictate next step</div></div>
      </div>
      <div id="return-forget" class="forget"><div id="return-forget-label" class="label">Forget checkpoint</div></div>
    </div>
  </div>
  <div id="plan-note" class="note">-</div>
  <div class="buttons">
    <div id="plan-apply" class="primary"><div id="plan-apply-label" class="label">Apply</div></div>
    <div id="plan-reply" class="primary" style="display: none"><div id="plan-reply-label" class="label">Reply</div></div>
    <div id="plan-discard" class="btn"><div id="plan-discard-label" class="label">Discard</div></div>
  </div>
</div>
