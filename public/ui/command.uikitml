<!--
  SpatialDesk Command Center. Units are centimetres (the scene node is not scaled): a 36 cm panel by the left hand,
  within arm's reach. Buttons are 15.5 x 8 cm (primary-size targets, ROADMAP heuristic A); text is off-white on
  dark grey (>= 7:1, heuristic B). In the browser the ScreenSpace component shows the same panel as a HUD.
  No :hover styles: the app paints hover (src/panel.ts), because a :hover layer sticks on restyled elements.
-->
<style>
  .root { flex-direction: column; width: 36; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; gap: 1.2; background-color: #15181e; border-radius: 2.4; border-width: 0.3; border-color: #2c333d; }
  .title { font-size: 2.8; font-weight: 700; color: #eef1f5; }
  .row { flex-direction: row; align-items: center; gap: 1; }
  .dot { width: 1.2; height: 1.2; border-radius: 0.6; background-color: #f2b84b; }
  .status { flex-shrink: 1; font-size: 1.6; font-weight: 700; color: #eef1f5; }
  .detail { font-size: 1.4; color: #b9c2cf; }
  .notice { min-height: 5; padding-top: 1; padding-bottom: 1; padding-left: 1.2; padding-right: 1.2; border-radius: 1.2; background-color: #1d222a; font-size: 1.6; color: #eef1f5; }
  .buttons { flex-direction: row; gap: 1; }
  .btn { flex-grow: 1; flex-basis: 0; height: 8; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2a313b; border-width: 0.3; border-color: #2a313b; }
  .primary { flex-grow: 1; flex-basis: 0; height: 8; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2f5f9e; border-width: 0.3; border-color: #2f5f9e; }
  .chips-title { margin-bottom: -0.4; font-size: 1.4; font-weight: 700; color: #9cc3ff; }
  .label { font-size: 1.8; font-weight: 700; color: #eef1f5; }
</style>
<div id="command-root" class="root">
  <div class="title">SpatialDesk Command</div>
  <div class="row">
    <div id="status-dot" class="dot"></div>
    <div id="status-text" class="status">Connecting to the command server...</div>
  </div>
  <div id="status-detail" class="detail">-</div>
  <div id="notice" class="notice">Tap a card to pick it up, then tap where it goes.</div>
  <div class="chips-title">Ask the AI</div>
  <div class="buttons">
    <div id="plan-button" class="primary"><div class="label">Plan my day</div></div>
    <div id="prioritise-button" class="primary"><div class="label">Prioritise</div></div>
  </div>
  <div class="buttons">
    <div id="focus-button" class="btn"><div class="label">Focus 25</div></div>
    <div id="clear-button" class="btn"><div class="label">Clear done</div></div>
  </div>
  <div class="buttons">
    <div id="arrange-button" class="btn"><div class="label">Bring to me</div></div>
    <div id="undo-button" class="btn"><div id="undo-label" class="label">Undo</div></div>
  </div>
  <div class="buttons">
    <div id="xr-button" class="primary"><div class="label">Enter workspace</div></div>
    <div id="exit-button" class="btn" style="display: none"><div class="label">Exit to browser</div></div>
  </div>
</div>
