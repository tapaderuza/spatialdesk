<!--
  SpatialDesk Command Center. Units are centimetres (the scene node is not scaled): a 36 cm panel by the left hand,
  within arm's reach. Buttons are 15.5 x 8 cm (primary-size targets, ROADMAP heuristic A); text is off-white on
  dark grey (>= 7:1, heuristic B). In the browser the ScreenSpace component shows the same panel as a HUD.
  No :hover styles: the app paints hover (src/panel.ts), because a :hover layer sticks on restyled elements.
-->
<style>
  .root { flex-direction: column; width: 36; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; gap: 1.2; background-color: #15181e; border-radius: 2.4; border-width: 0.3; border-color: #2c333d; }
  .title { font-size: 2.8; font-weight: 700; color: #eef1f5; }
  .row { flex-direction: row; align-items: center; gap: 1; }
  .dot { width: 1.2; height: 1.2; border-radius: 0.6; background-color: #f2b84b; }
  .status { flex-shrink: 1; font-size: 1.6; font-weight: 700; color: #eef1f5; }
  .detail { font-size: 1.4; color: #b9c2cf; }
  .notice { min-height: 6.2; border-width: 0.3; border-color: #1d222a; padding-top: 1; padding-bottom: 1; padding-left: 1.2; padding-right: 1.2; border-radius: 1.2; background-color: #1d222a; font-size: 1.6; color: #eef1f5; }
  .buttons { flex-direction: row; gap: 1; }
  .btn { flex-grow: 1; flex-basis: 0; height: 8; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2a313b; border-width: 0.3; border-color: #2a313b; }
  .primary { flex-grow: 1; flex-basis: 0; height: 8; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2f5f9e; border-width: 0.3; border-color: #2f5f9e; }
  .chips-title { margin-bottom: -0.4; font-size: 1.4; font-weight: 700; color: #9cc3ff; }
  .memory-link { flex-grow: 1; flex-basis: 0; height: 6.4; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2a313b; border-width: 0.3; border-color: #2a313b; }
  .label { font-size: 1.8; font-weight: 700; color: #eef1f5; }
  .week { flex-direction: row; align-items: center; gap: 0.7; }
  .week-label { flex-grow: 1; font-size: 1.4; color: #b9c2cf; }
  .day { width: 2.6; height: 1.6; align-items: center; justify-content: center; border-radius: 0.5; background-color: #2a313b; border-width: 0.2; border-color: #2a313b; }
  .mark { font-size: 1.1; font-weight: 700; color: #15181e; }
  .week-label:dark { color: #ffffff; }
  .root:dark { background-color: #000000; border-color: #ffffff; }
  .title:dark { color: #ffffff; }
  .status:dark { color: #ffffff; }
  .detail:dark { color: #ffffff; }
  .chips-title:dark { color: #ffd400; }
  .notice:dark { background-color: #000000; }
  .label:dark { color: #ffffff; }
</style>
<div id="command-root" class="root">
  <div class="title">SpatialDesk Command</div>
  <div class="row">
    <div id="status-dot" class="dot"></div>
    <div id="status-text" class="status">Connecting to the command server...</div>
  </div>
  <div id="status-detail" class="detail">-</div>
  <div class="week">
    <div class="week-label">Last 7 days</div>
    <div id="day-0" class="day"><div id="day-0-mark" class="mark">-</div></div>
    <div id="day-1" class="day"><div id="day-1-mark" class="mark">-</div></div>
    <div id="day-2" class="day"><div id="day-2-mark" class="mark">-</div></div>
    <div id="day-3" class="day"><div id="day-3-mark" class="mark">-</div></div>
    <div id="day-4" class="day"><div id="day-4-mark" class="mark">-</div></div>
    <div id="day-5" class="day"><div id="day-5-mark" class="mark">-</div></div>
    <div id="day-6" class="day"><div id="day-6-mark" class="mark">-</div></div>
  </div>
  <div id="notice" class="notice">Tap a card to pick it up, then tap where it goes.</div>
  <div class="row" style="justify-content: space-between">
    <div id="memory-button" class="memory-link"><div class="label">My setup</div></div>
    <div id="session-button" class="memory-link"><div class="label">Next session</div></div>
  </div>
  <div class="buttons">
    <div id="plan-button" class="primary"><div class="label">Plan my day</div></div>
    <div id="prioritise-button" class="primary"><div class="label">Prioritise</div></div>
    <div id="talk-button" class="primary"><div id="talk-label" class="label">Talk</div></div>
  </div>
  <div class="buttons">
    <div id="start-button" class="btn"><div class="label">Start small</div></div>
    <div id="focus-button" class="btn"><div class="label">Focus 25</div></div>
    <div id="wrap-button" class="btn"><div class="label">Wrap up</div></div>
  </div>
  <div class="buttons">
    <div id="log-button" class="btn"><div class="label">AI log</div></div>
    <div id="arrange-button" class="btn"><div class="label">Bring to me</div></div>
    <div id="undo-button" class="btn"><div id="undo-label" class="label">Undo</div></div>
  </div>
  <div class="buttons">
    <div id="contrast-button" class="btn"><div class="label">Contrast</div></div>
    <div id="sound-button" class="btn"><div class="label">Sound</div></div>
    <div id="voice-button" class="btn"><div class="label">Read aloud</div></div>
  </div>
  <div class="buttons">
    <div id="handsfree-button" class="btn"><div class="label">Hands-free</div></div>
    <div id="xr-button" class="primary"><div class="label">Enter VR</div></div>
    <div id="room-button" class="primary"><div class="label">In my room</div></div>
    <div id="fit-button" class="primary" style="display: none"><div class="label">Fit room</div></div>
    <div id="exit-button" class="btn" style="display: none"><div class="label">Exit</div></div>
  </div>
</div>
