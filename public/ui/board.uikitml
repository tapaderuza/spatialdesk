<!--
  SpatialDesk board panel. Units are centimetres and the app sizes the document to 72 x 50 cm, so these are
  real-world sizes: cards are 6.4 cm tall (>= 6 cm targets, ROADMAP heuristic A), text is off-white on dark grey
  (>= 7:1). Slots are fixed: the app fills 4 columns x 4 cards and hides what a board does not use, so the layout
  never rebuilds. No :hover styles: the app paints hover itself (src/workspace/boards.ts), because a :hover layer
  stays stuck on elements the app also restyles.
-->
<style>
  .board { flex-direction: column; width: 72; height: 50; padding-top: 2; padding-bottom: 2; padding-left: 2; padding-right: 2; background-color: #15181e; border-radius: 2.4; border-width: 0.3; border-color: #2c333d; }
  .header { flex-direction: row; align-items: center; height: 6; margin-bottom: 1.4; }
  .title { flex-grow: 1; font-size: 3.2; font-weight: 700; color: #eef1f5; }
  .focus { height: 6; width: 17; margin-left: 1.2; align-items: center; justify-content: center; border-radius: 1.4; background-color: #2f5f9e; border-width: 0.3; border-color: #2f5f9e; }
  .focus-label { font-size: 2; font-weight: 700; color: #eef1f5; }
  .columns { flex-direction: row; flex-grow: 1; gap: 1.2; }
  .column { flex-direction: column; flex-grow: 1; flex-basis: 0; gap: 0.8; padding-top: 1; padding-bottom: 1; padding-left: 1; padding-right: 1; border-radius: 1.6; background-color: #1d222a; border-width: 0.3; border-color: #1d222a; }
  .column-head { flex-direction: row; align-items: center; justify-content: space-between; height: 4.4; padding-left: 0.6; padding-right: 0.6; }
  .column-title { font-size: 2; font-weight: 700; color: #b9c2cf; }
  .column-count { font-size: 1.8; color: #96a0ae; }
  .card { flex-direction: row; align-items: center; height: 6.4; padding-left: 0.8; padding-right: 1; border-radius: 1.2; background-color: #2a313b; border-width: 0.3; border-color: #2a313b; overflow: hidden; }
  .mark { width: 0.6; height: 3.8; margin-right: 1; border-radius: 0.3; background-color: #4c5664; }
  .card-text { flex-grow: 1; flex-shrink: 1; font-size: 1.9; color: #eef1f5; }
  .card-min { flex-shrink: 0; margin-left: 0.6; font-size: 1.5; color: #b9c2cf; }
  .more { height: 2.6; padding-left: 0.6; font-size: 1.7; color: #96a0ae; }
</style>
<div id="board" class="board">
  <div class="header">
    <div id="title" class="title">Board</div>
    <div id="focus" class="focus"><div class="focus-label">Bring here</div></div>
  </div>
  <div class="columns">
    <div id="col-0" class="column">
      <div id="col-0-head" class="column-head">
        <div id="col-0-title" class="column-title">Column</div>
        <div id="col-0-count" class="column-count">0</div>
      </div>
      <div id="card-0-0" class="card"><div id="card-0-0-mark" class="mark"></div><div id="card-0-0-text" class="card-text">Card</div><div id="card-0-0-min" class="card-min">-</div></div>
      <div id="card-0-1" class="card"><div id="card-0-1-mark" class="mark"></div><div id="card-0-1-text" class="card-text">Card</div><div id="card-0-1-min" class="card-min">-</div></div>
      <div id="card-0-2" class="card"><div id="card-0-2-mark" class="mark"></div><div id="card-0-2-text" class="card-text">Card</div><div id="card-0-2-min" class="card-min">-</div></div>
      <div id="card-0-3" class="card"><div id="card-0-3-mark" class="mark"></div><div id="card-0-3-text" class="card-text">Card</div><div id="card-0-3-min" class="card-min">-</div></div>
      <div id="col-0-more" class="more">+0 more</div>
    </div>
    <div id="col-1" class="column">
      <div id="col-1-head" class="column-head">
        <div id="col-1-title" class="column-title">Column</div>
        <div id="col-1-count" class="column-count">0</div>
      </div>
      <div id="card-1-0" class="card"><div id="card-1-0-mark" class="mark"></div><div id="card-1-0-text" class="card-text">Card</div><div id="card-1-0-min" class="card-min">-</div></div>
      <div id="card-1-1" class="card"><div id="card-1-1-mark" class="mark"></div><div id="card-1-1-text" class="card-text">Card</div><div id="card-1-1-min" class="card-min">-</div></div>
      <div id="card-1-2" class="card"><div id="card-1-2-mark" class="mark"></div><div id="card-1-2-text" class="card-text">Card</div><div id="card-1-2-min" class="card-min">-</div></div>
      <div id="card-1-3" class="card"><div id="card-1-3-mark" class="mark"></div><div id="card-1-3-text" class="card-text">Card</div><div id="card-1-3-min" class="card-min">-</div></div>
      <div id="col-1-more" class="more">+0 more</div>
    </div>
    <div id="col-2" class="column">
      <div id="col-2-head" class="column-head">
        <div id="col-2-title" class="column-title">Column</div>
        <div id="col-2-count" class="column-count">0</div>
      </div>
      <div id="card-2-0" class="card"><div id="card-2-0-mark" class="mark"></div><div id="card-2-0-text" class="card-text">Card</div><div id="card-2-0-min" class="card-min">-</div></div>
      <div id="card-2-1" class="card"><div id="card-2-1-mark" class="mark"></div><div id="card-2-1-text" class="card-text">Card</div><div id="card-2-1-min" class="card-min">-</div></div>
      <div id="card-2-2" class="card"><div id="card-2-2-mark" class="mark"></div><div id="card-2-2-text" class="card-text">Card</div><div id="card-2-2-min" class="card-min">-</div></div>
      <div id="card-2-3" class="card"><div id="card-2-3-mark" class="mark"></div><div id="card-2-3-text" class="card-text">Card</div><div id="card-2-3-min" class="card-min">-</div></div>
      <div id="col-2-more" class="more">+0 more</div>
    </div>
    <div id="col-3" class="column">
      <div id="col-3-head" class="column-head">
        <div id="col-3-title" class="column-title">Column</div>
        <div id="col-3-count" class="column-count">0</div>
      </div>
      <div id="card-3-0" class="card"><div id="card-3-0-mark" class="mark"></div><div id="card-3-0-text" class="card-text">Card</div><div id="card-3-0-min" class="card-min">-</div></div>
      <div id="card-3-1" class="card"><div id="card-3-1-mark" class="mark"></div><div id="card-3-1-text" class="card-text">Card</div><div id="card-3-1-min" class="card-min">-</div></div>
      <div id="card-3-2" class="card"><div id="card-3-2-mark" class="mark"></div><div id="card-3-2-text" class="card-text">Card</div><div id="card-3-2-min" class="card-min">-</div></div>
      <div id="card-3-3" class="card"><div id="card-3-3-mark" class="mark"></div><div id="card-3-3-text" class="card-text">Card</div><div id="card-3-3-min" class="card-min">-</div></div>
      <div id="col-3-more" class="more">+0 more</div>
    </div>
  </div>
</div>
